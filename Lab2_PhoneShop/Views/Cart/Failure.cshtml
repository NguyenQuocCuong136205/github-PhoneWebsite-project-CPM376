@{
    ViewData["Title"] = "Thanh toán thất bại";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <div class="card shadow-lg border-0 rounded-lg p-5 bg-white">
                <div class="mb-4">
                    <div class="d-inline-flex justify-content-center align-items-center bg-danger text-white rounded-circle" style="width: 100px; height: 100px; font-size: 50px;">
                        <i class="fas fa-times"></i>
                    </div>
                </div>
                
                <h1 class="display-5 font-weight-bold text-danger mb-3">Thanh Toán Thất Bại!</h1>
                <p class="lead text-muted mb-4">
                    Rất tiếc, đã có lỗi xảy ra trong quá trình xử lý giao dịch của bạn.
                </p>

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger border-0 rounded-lg shadow-sm p-4 text-start mb-4">
                        <h5 class="font-weight-bold alert-heading mb-2">Chi tiết lỗi:</h5>
                        <p class="mb-0">@TempData["Error"]</p>
                    </div>
                }

                <div class="d-flex justify-content-center gap-3">
                    <a href="/Cart" class="btn btn-danger btn-lg px-4 rounded-pill shadow-sm">
                        <i class="fas fa-shopping-cart me-2"></i> Quay lại giỏ hàng
                    </a>
                    <a href="/" class="btn btn-outline-secondary btn-lg px-4 rounded-pill shadow-sm">
                        Quay về trang chủ
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
