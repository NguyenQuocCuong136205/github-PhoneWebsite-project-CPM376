@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <div class="card shadow-lg border-0 rounded-lg p-5 bg-white">
                <div class="mb-4">
                    <div class="d-inline-flex justify-content-center align-items-center bg-success text-white rounded-circle" style="width: 100px; height: 100px; font-size: 50px;">
                        <i class="fas fa-check"></i>
                    </div>
                </div>
                
                <h1 class="display-5 font-weight-bold text-success mb-3">Thanh Toán Thành Công!</h1>
                <p class="lead text-muted mb-4">
                    Cảm ơn bạn đã mua sắm tại PhoneShop. Đơn hàng của bạn đã được tiếp nhận và xử lý thành công.
                </p>

                <div class="bg-light p-4 rounded-lg mb-4 text-start">
                    <h5 class="font-weight-bold mb-3 border-bottom pb-2">Thông tin đơn hàng</h5>
                    <div class="row">
                        <div class="col-sm-6 mb-2">
                            <strong>Mã đơn hàng:</strong> <span class="text-primary">#@ViewBag.OrderId</span>
                        </div>
                        <div class="col-sm-6 mb-2">
                            <strong>Trạng thái:</strong> <span class="badge bg-success">Đã xác nhận</span>
                        </div>
                        <div class="col-sm-6 mb-2">
                            <strong>Phương thức:</strong> <span>PayPal / COD</span>
                        </div>
                        <div class="col-sm-6 mb-2">
                            <strong>Thời gian:</strong> <span>@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-center gap-3">
                    <a href="/" class="btn btn-primary btn-lg px-4 rounded-pill shadow-sm">
                        <i class="fas fa-home me-2"></i> Quay về trang chủ
                    </a>
                    <a href="/Product" class="btn btn-outline-secondary btn-lg px-4 rounded-pill shadow-sm">
                        Tiếp tục mua sắm <i class="fas fa-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
